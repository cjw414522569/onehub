{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["../web/app/node_modules/@types"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "../web/app/src"]
}