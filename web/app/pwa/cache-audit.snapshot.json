{
  "schema_version": 1,
  "service_worker": {
    "install": "ssh-shell-1.0.0",
    "update": {
      "next": "1.1.0",
      "waiting": true
    },
    "activate_purged": [
      "ssh-shell-1.0.0",
      "ssh-shell-0.9.0"
    ],
    "active_after": "ssh-shell-1.1.0",
    "session_cache_memory_only": "ssh-session-v0"
  },
  "cache_audit": {
